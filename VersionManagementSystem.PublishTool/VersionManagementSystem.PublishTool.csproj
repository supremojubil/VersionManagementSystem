<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>VersionManagementSystem.PublishTool</RootNamespace>
		<AssemblyName>VersionManagementSystem.PublishTool</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- Core contains shared version contracts/validation; the Publish Tool does not reference Infrastructure/EF Core. -->
		<ProjectReference Include="..\VersionManagementSystem.Core\VersionManagementSystem.Core.csproj" />
	</ItemGroup>

</Project>
