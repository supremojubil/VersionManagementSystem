<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<RootNamespace>VersionManagementSystem.Updater</RootNamespace>
		<AssemblyName>VersionManagementSystem.Updater</AssemblyName>

		<!-- Publish as a standalone Windows executable -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\VersionManagementSystem.Client\VersionManagementSystem.Client.csproj" />
		<ProjectReference Include="..\VersionManagementSystem.Core\VersionManagementSystem.Core.csproj" />
	</ItemGroup>

</Project>